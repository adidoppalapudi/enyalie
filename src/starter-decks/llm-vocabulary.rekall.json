{
  "format": "rekall-deck",
  "version": 1,
  "deck": {
    "id": "deck-llm-vocabulary",
    "name": "LLM Vocabulary",
    "description": "Key terms for working with large language models."
  },
  "questions": [
    {
      "type": "multiple_choice",
      "prompt": "In an LLM, what is a \"token\"?",
      "choices": [
        "A chunk of text, such as a word or part of a word, that the model processes",
        "A password for the API",
        "A single neuron",
        "A full sentence"
      ],
      "correctIndex": 0,
      "difficulty": "easy",
      "tags": [
        "basics"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What is a model's \"context window\"?",
      "choices": [
        "The time it takes to reply",
        "The browser window used to chat",
        "The maximum amount of text, in tokens, it can consider at once",
        "The training dataset"
      ],
      "correctIndex": 2,
      "difficulty": "easy",
      "tags": [
        "basics"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What is an LLM \"hallucination\"?",
      "choices": [
        "Confident output that is false or not supported by the input or sources",
        "A model refusing a request",
        "A slow response",
        "A visual glitch"
      ],
      "correctIndex": 0,
      "difficulty": "easy",
      "tags": [
        "behaviour"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What does raising the \"temperature\" setting usually do?",
      "choices": [
        "Makes the model faster",
        "Makes outputs longer",
        "Lets the model read more text",
        "Makes outputs more random and varied"
      ],
      "correctIndex": 3,
      "explanation": "Low temperature makes output more focused and repeatable.",
      "difficulty": "medium",
      "tags": [
        "sampling"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What is \"top-p\" (nucleus) sampling?",
      "choices": [
        "Choosing the next token only from the smallest set whose combined probability reaches p",
        "Limiting replies to p words",
        "Returning the top p answers",
        "Picking the single most likely token"
      ],
      "correctIndex": 0,
      "difficulty": "hard",
      "tags": [
        "sampling"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What is an \"embedding\"?",
      "choices": [
        "A list of numbers representing text so that similar meanings are close together",
