        "A hidden prompt",
        "An image inside a document"
      ],
      "correctIndex": 0,
      "difficulty": "medium",
      "tags": [
        "retrieval"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "Which 2017 paper introduced the Transformer architecture?",
      "choices": [
        "\"ImageNet Classification with Deep CNNs\"",
