      "correctIndex": 1,
      "difficulty": "medium",
      "tags": [
        "architecture"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What is \"pretraining\"?",
      "choices": [
        "Training on a very large general text corpus to predict the next token",
