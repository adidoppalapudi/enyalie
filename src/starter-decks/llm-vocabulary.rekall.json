      "correctIndex": 1,
      "difficulty": "medium",
      "tags": [
        "history"
      ]
    },
    {
      "type": "multiple_choice",
      "prompt": "What does the attention mechanism let a model do?",
      "choices": [
        "Store memories between conversations",
        "Weigh how relevant each part of the input is to each other part",
        "Run faster on CPUs",
        "Browse the web"
