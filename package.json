  "license": "MIT",
  "description": "Local-first flashcards and quizzes: Anki-style decks with a quick, game-like quiz player.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
